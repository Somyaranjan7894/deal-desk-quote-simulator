# ==============================================================================
# Deal Desk Quote Simulator - Environment Variables Example
# Copy this file to .env (or frontend/.env.local and backend/.env as needed)
# ==============================================================================

# Frontend (Next.js)
# Base URL of the backend FastAPI service
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend (FastAPI)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
CATALOG_PATH=../data/catalog.json

# Gemini Deal Desk Copilot (Backend only - NEVER expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
